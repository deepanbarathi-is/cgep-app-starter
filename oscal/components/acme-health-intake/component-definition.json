                "control-id": "hipaa-164.312-e-1",
                "description": "The intake Lambda runs in the private subnets of the starter's VPC, reaching S3 and DynamoDB only through gateway endpoints, with a security group that allows no inbound traffic (GAP-05). Enforced by policies/hipaa_312e1_lambda_vpc.rego.",
                "props": [
                  {
                    "name": "hipaa-citation",
                    "value": "164.312(e)(1)"
